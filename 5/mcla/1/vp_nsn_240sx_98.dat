AIN_CURVE_TUNER", "def": {"t": 4, "clamp": true, "min": 0, "max": 2, "p": [[0, 3.1], [0.2, 1], [1, 1]]}, "rule": "f28 = curve(r) * gain152 * vol148 (type 4: x clamped to [min, max] first, then piecewise linear, flat outside)"}, "xfade": {"rise": "EQUAL_POWER_RISE(u) = sin(clamp(u,0,1) * pi/2)", "fall": "EQUAL_POWER_FALL(u) = sin((1 - clamp(u,0,1)) * pi/2)", "rule": "per layer: v = 1 when prevHi <= rpmSnd <= nextLo; else if lo < rpmSnd <= hi and rpmSnd < prevHi: RISE(1 - (prevHi - rpmSnd) / (prevHi - lo)); else if lo < rpmSnd <= hi and rpmSnd > nextLo: FALL((rpmSnd - nextLo) / (hi - nextLo)); else 0"}, "layers": [{"lo": 900, "hi": 1250, "rpm": 1000, "prevHi": 1, "nextLo": 1000, "snd": "PLAYER_VEHICLES_VP_NSN_240SX_98_96_HONDA_ACCORD_CUSTOM_1000_FIN", "w": "player_vehicles_vp_nsn_240sx_98/4b205b76", "dB": 4, "c": 0}, {"lo": 1000, "hi": 1500, "rpm": 1500, "prevHi": 1250, "nextLo": 1250, "snd": "PLAYER_VEHICLES_VP_NSN_240SX_98_96_HONDA_ACCORD_CUSTOM_1500_FIN", "w": "player_vehicles_vp_nsn_240sx_98/0acabd3e", "dB": 4, "c": 0}, {"lo": 1250, "hi": 2000, "rpm": 2000, "prevHi": 1500, "nextLo": 1500, "snd": "PLAYER_VEHICLES_VP_NSN_240SX_98_96_HONDA_ACCORD_CUSTOM_2000_FIN", "w": "player_vehicles_vp_nsn_240sx_98/99d38135", "dB": 3, "c": 0}, {"lo": 1500, "hi": 2500, "rpm": 2500, "prevHi": 2000, "nextLo": 2000, "snd": "PLAYER_VEHICLES_VP_NSN_240SX_98_96_HONDA_ACCORD_CUSTOM_2500_FIN", "w": "player_vehicles_vp_nsn_240sx_98/f8f1ddfc", "dB": 0, "c": 0}, {"lo": 2000, "hi": 3010, "rpm": 3010, "prevHi": 2500, "nextLo": 2500, "snd": "PLAYER_VEHICLES_VP_NSN_240SX_98_96_HONDA_ACCORD_CUSTOM_3000_FIN", "w": "player_vehicles_vp_nsn_240sx_98/67698f60", "dB": 0, "c": 0}, {"lo": 2500, "hi": 3520, "rpm": 3520, "prevHi": 3010, "nextLo": 3000, "snd": "PLAYER_VEHICLES_VP_NSN_240SX_98_96_HONDA_ACCORD_CUSTOM_3500_FIN", "w": "player_vehicles_vp_nsn_240sx_98/7bf747d5", "dB": 0, "c": 0}, {"lo": 3000, "hi": 4030, "rpm": 4030, "prevHi": 3520, "nextLo": 3500, "snd": "PLAYER_VEHICLES_VP_NSN_240SX_98_96_HONDA